{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ESNext", "DOM"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "jsx": "preserve", "allowJs": true, "checkJs": true, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true,
    "types": []
  },
  "include": ["src", "test", "js"],
  "exclude": ["legacy", "vendor", "packages"]
}
